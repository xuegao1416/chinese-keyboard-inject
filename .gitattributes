# Shell/C/Python sources run under WSL and Linux: never let CRLF into them.
* text=auto
*.sh   text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.py   text eol=lf
*.txt  text eol=lf
*.md   text
*.json text eol=lf
*.tsv  text eol=lf
*.log  text eol=lf

# Captured frames and anything byte-hashed by artifact.txt must stay byte-exact.
*.png  binary
*.gba  binary
*.zip  binary
*.7z   binary
*.ico  binary
*.cff  text eol=lf
